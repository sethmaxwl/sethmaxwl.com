{
  "name": "sethmaxwl-com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.15.0",
  "engines": {
    "node": "26.2.0"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "check": "astro check",
    "lint": "astro check && prettier --check \"**/*.{astro,css,js,json,md,mjs,ts,yaml,yml}\"",
    "format": "prettier --write \"**/*.{astro,css,js,json,md,mjs,ts,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{astro,css,js,json,md,mjs,ts,yaml,yml}\"",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:dist": "node --test tests/static-site/*.test.mjs",
    "test:e2e": "playwright test",
    "ci:verify": "yarn lint && yarn test && yarn build && yarn test:dist && yarn test:e2e",
    "preview": "astro preview --host 0.0.0.0"
  },
  "dependencies": {
    "astro": "^6.3.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
