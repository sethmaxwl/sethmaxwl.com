---
const { thumbnail } = Astro.props;
---

<figure class="editorial-visual">
  <img class="editorial-thumbnail" src={thumbnail.src} alt={thumbnail.alt} loading="lazy" decoding="async" />
</figure>

<style>
  .editorial-visual {
    margin: 0;
    overflow: hidden;
    background: var(--color-surface-mid);
    border: 1px solid var(--color-outline);
  }

  .editorial-thumbnail {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
