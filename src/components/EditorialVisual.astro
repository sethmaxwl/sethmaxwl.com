---
import type { CollectionEntry } from 'astro:content';

type Thumbnail = CollectionEntry<'work'>['data']['thumbnail'];

interface Props {
  thumbnail: Thumbnail;
}

const { thumbnail } = Astro.props;
---

<figure class="editorial-visual">
  <img
    class="editorial-thumbnail"
    src={thumbnail.src}
    alt={thumbnail.alt}
    width={thumbnail.width}
    height={thumbnail.height}
    loading="lazy"
    decoding="async"
  />
</figure>

<style>
  .editorial-visual {
    margin: 0;
    overflow: hidden;
    background: var(--color-surface-mid);
    border: 1px solid var(--color-outline);
  }

  .editorial-thumbnail {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
