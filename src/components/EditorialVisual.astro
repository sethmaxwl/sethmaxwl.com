---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

type Thumbnail = CollectionEntry<'work'>['data']['thumbnail'];

interface Props {
  thumbnail: Thumbnail;
}

const { thumbnail } = Astro.props;
const widths = [
  ...new Set([360, 640, thumbnail.src.width].filter((width) => width <= thumbnail.src.width)),
];
---

<figure class="editorial-visual">
  <Image
    class="editorial-thumbnail"
    src={thumbnail.src}
    alt={thumbnail.alt}
    widths={widths}
    sizes="(max-width: 840px) calc(100vw - 40px), 820px"
    format="webp"
    quality="high"
  />
</figure>

<style>
  .editorial-visual {
    margin: 0;
    overflow: hidden;
    background: var(--color-surface-mid);
    border: 1px solid var(--color-outline);
  }

  .editorial-thumbnail {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
