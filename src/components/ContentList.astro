---
import type { ContentListItem } from '@data/content';
import { formatContentDate } from '../utils/formatDate';

interface Props {
  items: ContentListItem[];
  headingLevel?: 2 | 3;
  showKind?: boolean;
}

const { items, headingLevel = 2, showKind = false } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<div class="content-list">
  {items.map((item) => (
    <article>
      <a href={item.href}>
        <div class="entry-meta">
          <time datetime={item.date.toISOString()}>{formatContentDate(item.date)}</time>
          {showKind && item.kind && <span class="entry-kind">{item.kind}</span>}
        </div>
        <Heading class="entry-title">{item.title}</Heading>
        <p>{item.description}</p>
      </a>
    </article>
  ))}
</div>

<style>
  .content-list {
    border-top: 1px solid var(--color-outline);
  }

  article {
    border-bottom: 1px solid var(--color-outline);
  }

  a {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: 2rem;
    text-decoration: none;
  }

  .entry-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .entry-kind {
    color: var(--color-accent);
  }

  .entry-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: 0;
  }

  p {
    grid-column: 2 / 3;
    margin: -0.75rem 0 0;
    color: var(--color-muted);
  }

  @media (max-width: 840px) {
    a {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .entry-meta {
      flex-direction: row;
      gap: 1rem;
    }

    p {
      grid-column: auto;
      margin: 0;
    }
  }
</style>
