---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import ProjectFeature from '@components/ProjectFeature.astro';
import { getWorkProjects } from '@data/content';

const projects = await getWorkProjects();
---

<BaseLayout title="Work" description="Selected software engineering projects by Seth Maxwell.">
  <PageIntro
    title="Shipping Department"
    description="A collection of projects I've led or contributed to."
  />
  <section class="container work-list">
    {
      projects.map((project, index) => (
        <ProjectFeature project={project} href={`/work/${project.id}/`} reverse={index % 2 === 1} />
      ))
    }
  </section>
</BaseLayout>

<style>
  .work-list {
    display: grid;
    gap: clamp(5rem, 10vw, 9rem);
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }
</style>
