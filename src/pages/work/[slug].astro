---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialVisual from '@components/EditorialVisual.astro';
import Icon from '@components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | Seth Maxwell`} description={project.data.description}>
  <article class="case-study">
    <header class="case-hero container">
      <h1 class="display">{project.data.title}</h1>
      <p class="subhead">{project.data.description}</p>
      {
        project.data.externalLink && (
          <a
            class="community-link"
            href={project.data.externalLink.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="community-link-label">{project.data.externalLink.label}</span>
            <Icon name="external-link" class="community-link-icon" />
          </a>
        )
      }
    </header>

    <section class="container">
      <EditorialVisual thumbnail={project.data.thumbnail} />
    </section>

    <section class="case-body container markdown-content">
      <Content />
    </section>
  </article>
</BaseLayout>

<style>
  .case-hero {
    padding-block: clamp(3.75rem, 9vw, 6.5rem) clamp(2rem, 5vw, 3.25rem);
  }

  .case-hero h1 {
    max-width: 13ch;
    margin: 0;
  }

  .case-hero .subhead {
    max-width: 42rem;
    margin: 1.35rem 0 0;
  }

  .community-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    max-width: min(100%, 40rem);
    margin-top: 1.25rem;
    padding: 0.78rem 0.95rem;
    border: 1px solid var(--color-outline);
    border-radius: 6px;
    background: var(--color-surface-low);
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .community-link:hover,
  .community-link:focus-visible {
    border-color: var(--color-outline-strong);
    background: var(--color-surface-mid);
    transform: translateY(-1px);
  }

  .community-link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .community-link-label {
    min-width: 0;
  }

  .community-link :global(.community-link-icon) {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: 1rem;
    transition: transform 160ms ease;
  }

  .community-link:hover :global(.community-link-icon),
  .community-link:focus-visible :global(.community-link-icon) {
    transform: translate(0.1rem, -0.1rem);
  }

  .case-body {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .case-body :global(p) {
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.8;
  }
</style>
