---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectFeature from '@components/ProjectFeature.astro';
import PageIntro from '@components/PageIntro.astro';
import { getFeaturedWorkProjects } from '@data/content';
import { createProfilePageStructuredData } from '@utils/structuredData';

const featuredProjects = await getFeaturedWorkProjects();
const profileStructuredData = createProfilePageStructuredData(Astro.site);
---

<BaseLayout type="profile" structuredData={profileStructuredData}>
  <PageIntro
    title="Reducing sighs per click."
    description="I'm a software engineer at Atlassian working on Bitbucket Cloud, where I improve the code review experience and AI-assisted workflows."
  />
  <section class="featured-work container">
    <h3 class="headline">What I've been up to lately:</h3>
    <div class="project-stack">
      {
        featuredProjects.map((project, index) => (
          <ProjectFeature
            project={project}
            href={`/work/${project.id}/`}
            reverse={index % 2 === 1}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    padding-block: 5rem;
  }

  .hero h1 {
    max-width: 12ch;
    margin: 0;
  }

  .hero .subhead {
    max-width: 46rem;
    margin: 2rem 0 0;
  }

  .featured-work {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .project-stack {
    display: grid;
    gap: clamp(5rem, 10vw, 9rem);
  }
</style>
