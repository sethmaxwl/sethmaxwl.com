---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectFeature from '@components/ProjectFeature.astro';
import { site } from '@data/site';
import { selectEntriesById } from '../utils/contentOrder';
import PageIntro from '@components/PageIntro.astro';

const projects = await getCollection('work');
const featuredProjects = selectEntriesById(projects, site.home.featuredWork);
const siteUrl = Astro.site ?? new URL('https://sethmaxwl.com');
const homeUrl = new URL('/', siteUrl).href;
const sameAs = [site.links.github, site.links.linkedin];
const profileStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${homeUrl}#profile`,
  url: homeUrl,
  name: 'Seth Maxwell | Software Engineer',
  description: site.description,
  mainEntity: {
    '@type': 'Person',
    '@id': `${homeUrl}#person`,
    name: site.name,
    url: homeUrl,
    jobTitle: 'Software Engineer',
    worksFor: {
      '@type': 'Organization',
      name: 'Atlassian',
    },
    sameAs,
  },
};
---

<BaseLayout
  title="Seth Maxwell | Software Engineer"
  description={site.description}
  type="profile"
  structuredData={profileStructuredData}
>
  <PageIntro
    title="Reducing sighs per click."
    description="I'm a software engineer at Atlassian working on Bitbucket Cloud, where I improve the code review experience and AI-assisted workflows."
  />
  <section class="featured-work container">
    <h3 class="headline">What I've been up to lately:</h3>
    <div class="project-stack">
      {
        featuredProjects.map((project, index) => (
          <ProjectFeature
            project={project}
            href={`/work/${project.id}/`}
            reverse={index % 2 === 1}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    padding-block: 5rem;
  }

  .hero h1 {
    max-width: 12ch;
    margin: 0;
  }

  .hero .subhead {
    max-width: 46rem;
    margin: 2rem 0 0;
  }

  .featured-work {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .project-stack {
    display: grid;
    gap: clamp(5rem, 10vw, 9rem);
  }
</style>
