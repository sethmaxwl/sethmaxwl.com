---
import SiteHeader from '@components/SiteHeader.astro';
import SiteFooter from '@components/SiteFooter.astro';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Seth Maxwell',
  description = 'Software engineer at Atlassian working on Bitbucket Cloud, frontend architecture, and developer tools.',
} = Astro.props;

const googleAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID?.trim();
const enableGoogleAnalytics = /^G-[A-Z0-9]+$/.test(googleAnalyticsId ?? '');
const googleAnalyticsScript = enableGoogleAnalytics
  ? `
window.dataLayer = window.dataLayer || [];
function gtag() {
  window.dataLayer.push(arguments);
}
gtag('js', new Date());
gtag('config', ${JSON.stringify(googleAnalyticsId)});
`
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#fdf8f7" />
    <title>{title}</title>
    {
      enableGoogleAnalytics && (
        <>
          <script
            async
            is:inline
            src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
          />
          <script is:inline set:html={googleAnalyticsScript} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
